# ===============================
# FRC / WPILib Git Attributes
# ===============================

# Normalize line endings across OSes
* text=auto eol=lf

# Windows-specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts
*.sh text eol=lf

# Gradle / Java
*.gradle text eol=lf
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf

# C++ (if applicable)
*.cpp text eol=lf
*.hpp text eol=lf
*.h   text eol=lf

# Python
*.py text eol=lf

# Mark binaries explicitly
*.jar binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary

# WPILib / SysId logs
*.wpilog binary
*.hoot binary
*.json text eol=lf

# Prevent Windows-invalid filenames from sneaking in
desktop.ini -text
